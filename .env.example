# ========================================================
# zLowStudio Chat - Variables de Entorno (Render / Producción)
# ========================================================

# Puerto del servidor (Por defecto en Render o local: 3000)
PORT=3000

# --------------------------------------------------------
# 1. BASE DE DATOS EN LA NUBE (PERSISTENCIA TOTAL EN RENDER)
# Puedes elegir MongoDB Atlas (Gratis) o PostgreSQL de Render (Gratis).
# Agrega UNA de las dos en el panel "Environment" de tu servicio en Render:
# --------------------------------------------------------

# Opción A: MongoDB Atlas (Cluster Gratuito M0 en mongodb.com)
# MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@cluster0.abcde.mongodb.net/zlowchat?retryWrites=true&w=majority

# Opción B: PostgreSQL (Base de datos PostgreSQL gratuita de Render)
# DATABASE_URL=postgresql://zlow_user:password@dpg-xxxxxx-a.oregon-postgres.render.com/zlowdb

# --------------------------------------------------------
# 2. SEGURIDAD Y ADMINISTRACIÓN
# --------------------------------------------------------
# Contraseña para acceder al Panel de Control de Administrador / Owner
ADMIN_PASSWORD=1509

# --------------------------------------------------------
# 3. LLAMADAS WEBRTC (STUN / TURN METERED)
# Si deseas servidor TURN personalizado de metered.ca para saltar cortafuegos y datos móviles:
# --------------------------------------------------------
# METERED_DOMAIN=zlowstudio.metered.live
# METERED_API_KEY=tu-clave-api-metered
