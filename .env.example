# Server Port (default 3000)
PORT=3000

# Administrator access password
ADMIN_PASSWORD=1509

# Data persistence directory (defaults to ./data)
DATA_DIR=

# Optional GIF Provider API Keys (klipy or giphy)
GIF_PROVIDER=klipy
GIF_API_KEY=

# Optional WebRTC TURN configuration (Metered)
METERED_API_KEY=
METERED_DOMAIN=
METERED_USERNAME=
METERED_PASSWORD=
TURN_USERNAME=
TURN_PASSWORD=

# Optional external databases (local atomic JSON fallback is used if not provided)
MONGODB_URI=
DATABASE_URL=